# Copy to .env.local and replace with values from Supabase + OpenAI (see tasks/human-tasks.md).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_AUDIO=recordings
OPENAI_API_KEY=
# Optional: Anthropic for summaries, outputs, chat (transcription stays on OpenAI Whisper)
# ANTHROPIC_API_KEY=
# Optional: default https://api.openai.com/v1 (Azure / proxies use their base + /v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Database migration (add SUPABASE_DB_PASSWORD from Dashboard → Settings → Database)
# SUPABASE_DB_PASSWORD=
# Global search drops weak vector matches (default 0.38). Lower (e.g. 0.28) if good queries return empty; raise to filter noise.
# SEARCH_MIN_SIMILARITY=0.38
